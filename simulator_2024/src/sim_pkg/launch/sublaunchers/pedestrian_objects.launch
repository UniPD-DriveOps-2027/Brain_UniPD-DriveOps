<?xml version="1.0" encoding="UTF-8"?>

<launch> 
  
    <!-- PEDESTRIAN OBSTACLES -->
    <node
        name  = "PED_OBJ_KL"
        pkg   = "gazebo_ros"
        type  = "spawn_model"
        args  = "-file $(find models_pkg)/pedestrian_object/model.sdf -sdf -model PED_OBJ_KL -x 5.659 -y 2.489 -z 0 -R 0 -P 0 -Y -1.571"/>

    <node
        name  = "PED_OBJ_MN"
        pkg   = "gazebo_ros"
        type  = "spawn_model"
        args  = "-file $(find models_pkg)/pedestrian_object/model.sdf -sdf -model PED_OBJ_MN -x 19.135 -y 2.737 -z 0 -R 0 -P 0 -Y -1.571"/>
	
<!-- <node
        name  = "PED_OBJ_AD_H"
        pkg   = "gazebo_ros"
        type  = "spawn_model"
        args  = "-file $(find models_pkg)/pedestrian_object/model.sdf -sdf -model PED_OBJ_AD_H -x 0.172 -y -12.200 -z 0 -R 0 -P 0 -Y 4.712391"/>
-->

</launch>
